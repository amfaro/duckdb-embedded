#!/usr/bin/env bash
#MISE description="Dispatch calc-duckdb-upgrade to amfaro/calc"
#MISE hide=true
#
# Reads release-metadata.env from release:publish. Run under doppler run, which
# provides RWX_DISPATCH_TOKEN for calc's .rwx/duckdb-upgrade.yml receiver.

set -euo pipefail

metadata() { sed -n "s/^$1=//p" release-metadata.env; }

params=()
for key in embedded_version runtime_image_ref runtime_image_digest manifest_url; do
  params+=(--param "${key//_/-}=$(metadata "${key}")")
done

RWX_ACCESS_TOKEN="${RWX_DISPATCH_TOKEN:?}" rwx dispatch calc-duckdb-upgrade "${params[@]}"
